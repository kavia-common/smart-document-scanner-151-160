<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/authRoot"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView android:text="Sign in to enable cloud sync" android:textSize="18sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <Button android:id="@+id/btnStartAuth" android:text="Start Sign-in"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp"/>
</LinearLayout>
